<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#0F0F13"
                android:endColor="#040405"
                android:startColor="#131116" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#08FF6A00"
                android:centerX="0.5"
                android:centerY="0.02"
                android:endColor="#00000000"
                android:gradientRadius="780dp"
                android:startColor="#16FF6A00"
                android:type="radial" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#067A4CFF"
                android:centerX="0.5"
                android:centerY="0.98"
                android:endColor="#00000000"
                android:gradientRadius="760dp"
                android:startColor="#0E7A4CFF"
                android:type="radial" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#06101016"
                android:endColor="#10000000"
                android:startColor="#06000000" />
        </shape>
    </item>

    <item
        android:height="420dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="#18000000" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00000000"
                android:endColor="#10000000"
                android:startColor="#08000000" />
        </shape>
    </item>

</layer-list>
