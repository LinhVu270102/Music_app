# SoundCloud server environment example
# Copy this file to soundcloud-server/.env and replace values with your own credentials.
# Never commit the real .env file.

PORT=3000

SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret

# Optional: Firebase Admin SDK service account path for local scripts and fingerprint endpoints.
# Do not commit the real serviceAccountKey.json file.
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional: path to Chromaprint fpcalc executable for audio fingerprint processing.
# Windows example: FPCALC_PATH=C:/tools/chromaprint/fpcalc.exe
# macOS/Linux example: FPCALC_PATH=fpcalc
# FPCALC_PATH=fpcalc

# Optional: base URL used by fingerprint scripts when Firestore has Android emulator URLs
# such as http://10.0.2.2:3000/...
# FINGERPRINT_LOCAL_PROXY_BASE_URL=http://127.0.0.1:3000
